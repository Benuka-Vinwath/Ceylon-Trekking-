PORT=3000
# Local PostgreSQL: use your own user and password. Special characters in the password (like @ or #) must be URL-encoded (@ becomes %40).
DATABASE_URL=postgres://ceylon:ceylon@localhost:5432/ceylon_trekking
# At least 16 random characters. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Set to 1 when hosted behind a proxy (Render, Railway...), so rate limits see real client addresses. Leave empty locally.
TRUST_PROXY=
